---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generateQuitclaimDeed, generateReceiptPDF } from '../../lib/pdf';

const title = 'Payment Successful — WhatIsAQuitclaimDeed.com';
const description = 'Your Complete Filing Bundle purchase is confirmed. Download your bundle now.';

// Capture the session/payment ID from the redirect URL if Dodo passes it back
const url = new URL(Astro.request.url);
const paymentId = url.searchParams.get('payment_id') ?? url.searchParams.get('session_id') ?? '';
const status = url.searchParams.get('status');
const rawEmail = url.searchParams.get('email');
const customerEmail = rawEmail ? decodeURIComponent(rawEmail) : null;
const downloadUrl = paymentId
  ? `/api/download-bundle?payment_id=${encodeURIComponent(paymentId)}`
  : null;

// Deduplication: only send email once per payment (cookie guard)
const sentCookie = paymentId ? Astro.cookies.get(`email_sent_${paymentId}`) : null;

if (!sentCookie?.value && status === 'succeeded' && paymentId) {
  try {
    const nodemailer = await import('nodemailer');
    const transporter = nodemailer.default.createTransport({
      host: 'smtp.gmail.com',
      port: 465,
      secure: true,
      auth: {
        user: import.meta.env.GMAIL_USER,
        pass: import.meta.env.GMAIL_APP_PASSWORD,
      },
    });

    // Operator notification email
    await transporter.sendMail({
      from: import.meta.env.GMAIL_USER,
      to: 'amitsharma00261@gmail.com',
      subject: `New sale: Quitclaim Deed — ${customerEmail || 'unknown'}`,
      html: `
        <h2>New Payment Received</h2>
        <p><strong>Payment ID:</strong> ${paymentId}</p>
        <p><strong>Customer email:</strong> ${customerEmail || 'not provided'}</p>
        <p><strong>Amount:</strong> $19.97</p>
        <p><strong>Time:</strong> ${new Date().toISOString()}</p>
        <p><strong>Status:</strong> ${status}</p>
      `,
    });

    // Customer confirmation email with PDF attached (if we have their address)
    if (customerEmail) {
      // Attempt to generate the populated deed from the stored cookie
      const deedDataCookie = Astro.cookies.get('deed_data');
      let pdfBuffer: Buffer;
      try {
        if (deedDataCookie?.value) {
          const raw = JSON.parse(deedDataCookie.value) as Record<string, string>;
          pdfBuffer = await generateQuitclaimDeed({
            grantorName:      raw.grantorName?.trim()      || '____________________________',
            granteeName:      raw.granteeName?.trim()       || '____________________________',
            propertyAddress:  raw.propertyAddress?.trim()   || '____________________________',
            legalDescription: raw.legalDescription?.trim()  || '[Copy from your existing deed]',
            consideration:    raw.consideration?.trim()      || 'Ten Dollars ($10.00) and other good and valuable consideration',
            state:            raw.state?.trim()              || 'YOUR STATE',
            county:           raw.county?.trim()             || undefined,
            grantorAddress:   raw.grantorAddress?.trim()     || undefined,
            granteeAddress:   raw.granteeAddress?.trim()     || undefined,
          });
        } else {
          pdfBuffer = await generateReceiptPDF(paymentId);
        }
      } catch (_err) {
        pdfBuffer = await generateReceiptPDF(paymentId);
      }

      await transporter.sendMail({
        from: import.meta.env.GMAIL_USER,
        to: customerEmail,
        subject: 'Your Quitclaim Deed — WhatIsAQuitclaimDeed.com',
        html: `
          <h2>Thank you for your purchase!</h2>
          <p>Your completed quitclaim deed is attached to this email as a PDF.</p>
          <p>You can also re-download it any time using the link below (valid 90 days):</p>
          <p><a href="https://whatisaquitclaimdeed.com/api/download-bundle?payment_id=${paymentId}" style="background:#d97706;color:white;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block">Re-download Your Deed</a></p>
          <p>Payment ID: ${paymentId}</p>
          <br>
          <p>If you have any questions, reply to this email or contact us at support@whatisaquitclaimdeed.com</p>
          <p>WhatIsAQuitclaimDeed.com</p>
        `,
        attachments: [{
          filename: 'quitclaim-deed.pdf',
          content: pdfBuffer,
          contentType: 'application/pdf',
        }],
      });
    }

    // Set cookie to prevent re-send on refresh (24 h)
    Astro.cookies.set(`email_sent_${paymentId}`, '1', {
      maxAge: 86400,
      httpOnly: true,
      path: '/',
    });
  } catch (e) {
    // Don't crash the page if email fails
    console.error('Email send failed:', e);
  }
}
---

<BaseLayout title={title} description={description} canonical="/payment/success/">
  <div class="page-content">
    <div class="success-card">
      <div class="success-icon" aria-hidden="true">✓</div>
      <h1 class="success-h1">Thank you for your purchase!</h1>

      <p class="success-lead">
        Your Complete Filing Bundle is ready. You should also receive a confirmation email with
        a download link within a few minutes — check your spam folder if it doesn't arrive.
      </p>

      {downloadUrl ? (
        <a href={downloadUrl} class="download-btn" id="download-btn" download>
          Download Your Filing Bundle
        </a>
      ) : (
        <p class="no-id-note">
          Check your email for your download link. If you don't receive it within a few
          minutes, <a href="/contact">contact us</a> with your payment confirmation and
          we'll send it right away.
        </p>
      )}

      <div class="receipt-note">
        <p>
          <strong>A receipt has been sent to your email.</strong> Keep it for your records —
          it includes your 90-day re-download reference number.
        </p>
      </div>

      <div class="what-next">
        <h2>What's in your bundle</h2>
        <ul>
          <li>County-specific recording checklist with exact requirements for your county</li>
          <li>Legal description guide — where to find it and what to copy word for word</li>
          <li>Post-signing step-by-step guide (notarise, witnesses, transfer tax, filing order)</li>
          <li>Transfer tax calculator for your county</li>
          <li>90-day re-download access — update and reprint any time</li>
        </ul>
      </div>

      <div class="back-links">
        <a href="/" class="back-link">← Back to Home</a>
        <a href="/contact" class="contact-link">Questions? Contact us</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Auto-trigger download 1.5 seconds after page load (gives the page time to render first)
  window.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement | null;
      if (downloadBtn) {
        window.location.href = downloadBtn.href;
      }
    }, 1500);
  });
</script>

<style>
  .page-content {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem clamp(1.25rem, 5vw, 2.5rem);
  }

  .success-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
    box-shadow: var(--shadow-md);
  }

  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: #d1fae5;
    color: #065f46;
    border-radius: 50%;
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-5);
  }

  .success-h1 {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4) 0;
    line-height: 1.2;
  }

  .success-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-6) 0;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #d97706;
    color: #fff;
    padding: 1rem 2rem;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-standard);
    margin-bottom: var(--space-6);
  }
  .download-btn::before {
    content: '↓';
    font-size: 1.1em;
  }
  .download-btn:hover {
    background: #b45309;
  }

  .no-id-note {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-6) 0;
    line-height: 1.6;
  }
  .no-id-note a {
    color: var(--color-teal);
    text-decoration: underline;
  }

  .receipt-note {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: #065f46;
    line-height: 1.6;
    text-align: left;
  }
  .receipt-note p {
    margin: 0;
  }

  .what-next {
    text-align: left;
    margin-bottom: var(--space-7);
  }
  .what-next h2 {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3) 0;
  }
  .what-next ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .what-next li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .what-next li::before {
    content: '✓';
    color: #059669;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.1em;
  }

  .back-links {
    display: flex;
    gap: var(--space-5);
    justify-content: center;
    flex-wrap: wrap;
  }
  .back-link, .contact-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .back-link:hover, .contact-link:hover {
    color: var(--color-teal);
    text-decoration: underline;
  }
</style>
