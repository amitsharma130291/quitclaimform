const title = 'Quitclaim Deed Template &mdash; Free, State-Specific Form | WhatIsAQuitclaimDeed.com';
const description =
  'Get a free quitclaim deed template or generate a state-specific form instantly. Covers every required field, common mistakes, and what to do after signing.';

const faqItems = [
  {
    question: 'Can I use a free printable quitclaim deed template from the internet?',
    answer:
      'You can, but verify that the template matches your state\'s requirements before using it. Check that it uses state-specific acknowledgment certificate language, includes any required witness blocks, and has space for any transfer tax disclosures your state mandates. When in doubt, use the state-specific generator at /quitclaim-deed-form/.',
  },
  {
    question: "Is it 'quit claim deed' or 'quitclaim deed'?",
    answer:
      'Both spellings refer to the same document. "Quitclaim deed" (one word) is the modern legal standard; "quit claim deed" (two words) appears in older deeds and some state statutes. Either spelling is generally valid on the document &mdash; the legal elements are what matter.',
  },
  {
    question: "What's the difference between a quitclaim deed template PDF and a Word version?",
    answer:
      'Both are fill-in-the-blank forms; the format just differs. A PDF with form fields is often easier to fill out neatly. A Word file is easier to edit if you need to modify the legal description formatting. Neither format affects whether the deed is legally valid &mdash; what matters is the content and proper execution.',
  },
  {
    question: 'If I want a quitclaim deed template Word version, can the generator produce one?',
    answer:
      'The generator produces a completed PDF. Most county recorders prefer PDF or printed forms over editable Word documents, which can be altered after signing.',
  },
  {
    question: 'Do I need a lawyer to fill out a quitclaim deed template?',
    answer:
      'Whether legal assistance is required or advisable depends on the jurisdiction and transaction. Professional review is particularly valuable when the transfer involves a mortgage, divorce, tax planning, title problems, trusts, or unusual ownership arrangements.',
  },
  {
    question: 'What if I make a mistake on the form?',
    answer:
      "Do not use correction fluid or cross things out. Reprint a clean copy and fill it in again. County recorders can reject deeds with visible alterations, and alterations after signing can raise questions about the deed's validity.",
  },
  {
    question: 'Is a quitclaim deed the same as adding someone to a deed?',
    answer:
      "Yes &mdash; one common use of a quitclaim deed is adding a co-owner. The current owner(s) convey the property to themselves and the new person together. The deed still must satisfy the applicable state's execution, acknowledgment, tax, and recording requirements.",
  },
  {
    question: 'How long does recording take?',
    answer:
      'Processing time varies substantially by recording office and submission method. Check the recorder\'s current processing times before filing.',
  },
];

const stateRequirementsHeaders = ['State', 'Key issues to verify'];
const stateRequirementsRows = [
  { label: 'Florida', values: ['Two subscribing witnesses; documentary stamp tax; Miami-Dade special rules'] },
  { label: 'California', values: ['Acknowledgment; PCOR; county and city transfer-tax requirements'] },
  { label: 'Texas', values: ['Acknowledgment; county recording; marital-property issues'] },
  { label: 'New York', values: ['Acknowledgment; state and local transfer-tax filings'] },
  { label: 'Tennessee', values: ['Execution and recording requirements; transfer-tax requirements'] },
  { label: 'Louisiana', values: ['Civil-law conveyance formalities; parish recording requirements'] },
];

const schema = [
