---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeedForm from '../components/DeedForm.astro';
import FAQ from '../components/FAQ.astro';
import Disclaimer from '../components/Disclaimer.astro';
import CitableAnswerBlock from '../components/CitableAnswerBlock.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://whatisaquitclaimdeed.com';

// ── Schema ─────────────────────────────────────────────────────────────────
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "WhatIsAQuitclaimDeed.com",
  "url": siteUrl,
  "description": "Quitclaim deed generator — state-specific, ready-to-sign PDF for all 50 states. $19.97 one-time payment, instant download.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": `${siteUrl}/quitclaim-deed/{state}/` },
    "query-input": "required name=state"
  }
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Quitclaim Deed Generator — $19.97",
  "description": "An online tool that generates a state-specific, legally formatted quitclaim deed PDF in minutes. Enter property and party details and download instantly. Covers all 50 states with the correct witness blocks, notary acknowledgment language, and state-specific instructions.",
  "serviceType": "Legal Document Generator",
  "provider": {
    "@type": "Organization",
    "name": "WhatIsAQuitclaimDeed.com",
    "url": siteUrl
  },
  "areaServed": { "@type": "Country", "name": "United States" },
  "offers": {
    "@type": "Offer",
    "price": "19.97",
    "priceCurrency": "USD",
    "description": "Quitclaim deed generator — $19.97 one-time payment, instant PDF download, taxes included"
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Create a Quitclaim Deed Online",
  "description": "Use WhatIsAQuitclaimDeed.com to create a state-specific quitclaim deed in under 10 minutes. Select your state, enter party and property details, and download a ready-to-sign PDF instantly.",
  "totalTime": "PT10M",
  "tool": [
    { "@type": "HowToTool", "name": "Quitclaim Deed Form Generator" },
    { "@type": "HowToTool", "name": "Notary Public" }
  ],
  "step": [
    {
      "@type": "HowToStep", "position": 1,
      "name": "Select your state",
      "text": "Choose the state where the property is located. Requirements vary significantly by state — the generator automatically applies the correct statutory language, signature blocks, and witness requirements."
    },
    {
      "@type": "HowToStep", "position": 2,
      "name": "Enter grantor and grantee information",
      "text": "Enter the full legal names and mailing addresses of the grantor (person transferring the interest) and the grantee (person receiving the interest). Names must exactly match the current title."
    },
    {
      "@type": "HowToStep", "position": 3,
      "name": "Enter the property legal description",
      "text": "Copy the legal description from the existing deed or county property records. Do not use the street address alone — the legal description is required. The generator explains where to find it."
    },
    {
      "@type": "HowToStep", "position": 4,
      "name": "Select vesting and consideration",
      "text": "Specify how the grantee will hold title (joint tenancy, tenancy in common, etc.) and the consideration amount. For family transfers, '$1 and other valuable consideration' is standard in most states."
    },
    {
      "@type": "HowToStep", "position": 5,
      "name": "Download your deed instantly",
      "text": "Complete checkout and download the ready-to-sign PDF instantly. Sign in front of a notary — and witnesses if your state requires them — then record with your county recorder."
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a quitclaim deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A quitclaim deed is a legal document that transfers whatever property interest the grantor currently holds to the grantee — with no warranty of title and no guarantee the grantor owns the property free and clear. It is commonly used between family members, divorcing spouses, and to transfer property into trusts or LLCs."
      }
    },
    {
      "@type": "Question",
      "name": "Does a quitclaim deed remove me from the mortgage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A quitclaim deed transfers property ownership only — it has no effect on the mortgage. The grantor remains personally liable on the loan until the lender refinances or formally releases them. This is one of the most important points for divorcing spouses."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a notary for a quitclaim deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, in all 50 states. The grantor's signature must be acknowledged before a notary public. Several states also require witnesses: Florida requires two witnesses under Fla. Stat. § 689.01; Georgia requires one. The generator includes the correct signature block for your state."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use the same quitclaim deed form in every state?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Quitclaim deed requirements are set by each state's property code. Florida requires two witnesses; California requires a Preliminary Change of Ownership Report at recording; Texas requires both spouses to sign on community property. A generic form is not automatically valid in every state."
      }
    },
    {
      "@type": "Question",
      "name": "How much does it cost to record a quitclaim deed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Recording fees vary by county — typically $10 to $30 for the first page, plus $5 to $15 per additional page. Many states also charge documentary transfer tax based on the consideration amount. Florida charges $0.70 per $100; Texas has no state deed transfer tax. The generator's instructions include current fee guidance for your state."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl + "/"
    }
  ]
};

// ── FAQ items for the FAQ component ────────────────────────────────────────
const faqItems = [
  {
    question: 'What is a quitclaim deed?',
    answer:
      'A quitclaim deed is a legal document that transfers whatever property interest the grantor currently holds to the grantee — with no warranty of title and no guarantee the grantor actually owns the property free and clear. It is commonly used between family members, divorcing spouses, and to transfer property into a trust or LLC. The grantor "quits" — meaning releases — their claim to the property.',
  },
  {
    question: 'Does a quitclaim deed remove me from the mortgage?',
    answer:
      'No. A quitclaim deed transfers property ownership only — it has no effect on the mortgage. If you sign over a property with a mortgage on it, you remain personally liable on the loan until the lender refinances or formally releases you. This is one of the most important points for divorcing spouses: a quitclaim deed from the departing spouse does not remove them from the mortgage.',
  },
  {
    question: 'Do I need a notary for a quitclaim deed?',
    answer:
      'Yes, in all 50 states. The grantor must sign the deed before a notary public. Several states also require one or two witnesses in addition to the notary — Florida and Louisiana require two witnesses; Georgia requires one. The generator includes the correct notary acknowledgment language and the right number of witness signature lines for whichever state you select.',
  },
  {
    question: 'What is the legal description, and where do I find it?',
    answer:
      'The legal description is the formal recorded description of the property boundaries — not the street address. Find it on the existing deed, in county property records, or in a title report. It looks like a metes-and-bounds description, a lot-and-block number within a recorded plat, or a section/township/range identifier. Using only a street address is legally insufficient and will result in the deed being rejected or defective.',
  },
  {
    question: 'Can I use the same quitclaim deed form in every state?',
    answer:
      'No. Quitclaim deed requirements are set by each state\'s property code. Florida requires two witnesses (Fla. Stat. § 689.01); California requires a Preliminary Change of Ownership Report at recording (Cal. Rev. & Tax. Code § 480.3); Texas requires both spouses to sign on community property (Tex. Fam. Code § 3.102). A generic form is not valid in every state. The generator applies the correct statutory language for whichever state you select.',
  },
  {
    question: 'How much does it cost to record a quitclaim deed?',
    answer:
      'Recording fees vary by county and state — typically $10 to $30 for the first page, plus $5 to $15 per additional page. Many states also charge documentary transfer or stamp tax: Florida charges $0.70 per $100 of consideration; California charges approximately $0.55 per $500; Texas has no state deed transfer tax. The generator\'s instruction sheet includes current recording fee guidance and transfer tax information for your state.',
  },
  {
    question: 'What happens if I make a mistake on a quitclaim deed?',
    answer:
      'Minor errors (a misspelled name, a transposed digit) may be correctable with a corrective quitclaim deed. More significant errors — a wrong legal description, reversed grantor and grantee names, missing required signatures — may require a new deed from the original grantor. If the original grantor is unavailable, correcting the title may require a quiet title action in court. Double-check every field before generating, and have a real estate attorney review the completed deed before recording.',
  },
  {
    question: 'Do I need a lawyer to prepare a quitclaim deed?',
    answer:
      'An attorney is not legally required in most states, and many people complete straightforward family transfers without one. However, an attorney is strongly recommended when: the property has a mortgage, the transfer is part of a divorce, the property is in California and involves a parent-to-child transfer after Prop 19, there is any ambiguity in the title history, or the transfer is part of an estate plan. This generator produces a legally formatted deed template — it does not verify your ownership interest or provide legal advice.',
  },
];
---

<BaseLayout
  title="Quitclaim Deed Generator — $19.97 | All 50 States | WhatIsAQuitclaimDeed.com"
  description="Generate a state-specific quitclaim deed in minutes — $19.97, instant download. Correct witness blocks, notary language, and recording instructions for all 50 states."
  canonical="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero__inner">
      <div class="hero__text">
        <div class="hero__eyebrow-wrap">
          <span class="hero__eyebrow-dot" aria-hidden="true"></span>
          <p class="hero__eyebrow">$19.97 (taxes included) — Instant Download</p>
        </div>
        <h1 class="hero__heading" id="hero-heading">
          Create a <span class="hero__gradient">State-Specific</span><br />Quitclaim Deed in Minutes — $19.97
        </h1>
        <p class="hero__subheading">
          Enter your details, choose your state, and download a legally correct
          quitclaim deed instantly. Covers all 50 states, with correct witness,
          notary, and recording instructions.
        </p>
        <ul class="hero__trust" aria-label="Key features">
          <li>
            <svg class="hero__check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            All 50 states with state-specific notary language
          </li>
          <li>
            <svg class="hero__check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Correct witness blocks (FL, GA, SC, TN and more)
          </li>
          <li>
            <svg class="hero__check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            County recording instructions included
          </li>
          <li>
            <svg class="hero__check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            $19.97 — one-time payment, instant download
          </li>
          <li>
            <svg class="hero__check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Taxes included. No subscription.
          </li>
        </ul>
      </div>

      <div class="hero__form-wrap" id="generator">
        <DeedForm />
        <Disclaimer />
      </div>
    </div>
  </section>

  <!-- ── Citable answer block ───────────────────────────────────────────── -->
  <section class="container section-gap" aria-labelledby="definition-heading">
    <CitableAnswerBlock
      question="What is a quitclaim deed?"
      answer="A quitclaim deed is a legal document that transfers whatever property interest the grantor currently holds to the grantee — with no warranty of title and no guarantee the grantor actually owns the property free and clear. It is valid in all 50 states when properly executed (signed before a notary, and witnessed where required) and recorded."
      source="Restatement (Third) of Property § 5.1; Cal. Civ. Code § 1092; Fla. Stat. § 689.02; Tex. Prop. Code § 5.022. Last verified: July 2026."
    />
    <p class="body-copy">
      Quitclaim deeds are most commonly used between parties who already know each other — spouses dividing property in a divorce, parents transferring a home to a child, an owner moving property into a trust or LLC, or someone clearing a name from a title. Because the deed carries no title warranty, it is not appropriate for standard arm's-length real estate sales. For a full explanation, see our guide on <a href="/what-is-a-quitclaim-deed/" class="text-link">what is a quitclaim deed</a>.
    </p>
  </section>

  <!-- ── How it works ───────────────────────────────────────────────────── -->
  <section class="how-it-works container section-gap" aria-labelledby="how-heading" id="how-it-works">
    <h2 class="section-heading" id="how-heading">How It Works</h2>
    <p class="section-intro">
      From first click to recorded deed in four steps. The generator handles the state-specific details automatically.
    </p>
    <ol class="steps-grid" role="list">
      <li class="step-card">
        <span class="step-card__num" aria-hidden="true">01</span>
        <h3 class="step-card__title">Select your state</h3>
        <p class="step-card__desc">
          Choose the state where the property is located. Witness requirements, notary acknowledgment language, documentary stamp tax rules, and required accompanying forms all vary by state. The generator applies the correct settings automatically.
        </p>
      </li>
      <li class="step-card">
        <span class="step-card__num" aria-hidden="true">02</span>
        <h3 class="step-card__title">Enter grantor, grantee, and property details</h3>
        <p class="step-card__desc">
          Full legal names (exactly as they appear on current title), mailing addresses, the property's legal description from the existing deed or county records, consideration amount, and how the grantee will hold title.
        </p>
      </li>
      <li class="step-card">
        <span class="step-card__num" aria-hidden="true">03</span>
        <h3 class="step-card__title">Download your deed instantly</h3>
        <p class="step-card__desc">
          Complete the $19.97 checkout and download your ready-to-sign PDF immediately. Includes a one-page instruction sheet covering notarisation, witness requirements, and recording instructions for your state.
        </p>
      </li>
      <li class="step-card">
        <span class="step-card__num" aria-hidden="true">04</span>
        <h3 class="step-card__title">Sign, notarise, and record</h3>
        <p class="step-card__desc">
          Sign before a notary public — do not sign before the notary is present. Bring witnesses if your state requires them. Take the signed deed to the county recorder's office. Pay the recording fee and the transfer is complete.
        </p>
      </li>
    </ol>
    <div class="how-it-works__cta">
      <a href="#generator" class="btn-primary">Get My Deed — $19.97</a>
    </div>
  </section>

  <!-- ── Why a generator instead of a generic PDF ─────────────────────── -->
  <section class="why-generator container section-gap" aria-labelledby="why-heading">
    <h2 class="section-heading" id="why-heading">Why State-Specific Matters</h2>
    <p class="section-intro">
      A generic quitclaim deed form is designed to work in the most permissive state possible. It may be accepted in some states. In others, it will be rejected — or worse, recorded but legally defective.
    </p>

    <div class="state-cards" role="list">
      <a href="/quitclaim-deed/florida/" class="state-card" role="listitem">
        <div class="state-card__top-accent" aria-hidden="true"></div>
        <div class="state-card__badge">Florida</div>
        <h3 class="state-card__rule">Two witnesses required</h3>
        <p class="state-card__detail">
          Under Fla. Stat. § 689.01, every deed must be signed before two witnesses plus a notary. A deed executed with only a notary and no witnesses is defective under Florida law. Most generic PDF templates include no witness lines at all.
        </p>
      </a>

      <a href="/quitclaim-deed/california/parents-to-children/" class="state-card" role="listitem">
        <div class="state-card__top-accent" aria-hidden="true"></div>
        <div class="state-card__badge">California</div>
        <h3 class="state-card__rule">PCOR required at recording</h3>
        <p class="state-card__detail">
          California requires a Preliminary Change of Ownership Report (form BOE-502-A) at the time of recording under Cal. Rev. &amp; Tax. Code § 480.3. Parent-to-child transfers after Prop 19 (Feb. 2021) must also apply for the reassessment exclusion with form BOE-19-P within three years.
        </p>
      </a>

      <a href="/quitclaim-deed-form/" class="state-card" role="listitem">
        <div class="state-card__top-accent" aria-hidden="true"></div>
        <div class="state-card__badge">Texas</div>
        <h3 class="state-card__rule">Both spouses must sign</h3>
        <p class="state-card__detail">
          Texas community property law (Tex. Fam. Code § 3.102) requires both spouses to sign any deed conveying community property — even if only one spouse is on the title. A deed from only one spouse may convey only that spouse's half-interest, leaving the other's intact.
        </p>
      </a>

      <a href="/quitclaim-deed-form/" class="state-card" role="listitem">
        <div class="state-card__top-accent" aria-hidden="true"></div>
        <div class="state-card__badge">Georgia</div>
        <h3 class="state-card__rule">One official witness required</h3>
        <p class="state-card__detail">
          Georgia requires one witness on a quitclaim deed under O.C.G.A. § 44-5-30, in addition to notarisation. Georgia also adopted a Transfer-on-Death Deed framework in 2024 (O.C.G.A. § 44-17-1) that may be relevant for estate-planning transfers.
        </p>
      </a>
    </div>
  </section>

  <!-- ── Common uses ─────────────────────────────────────────────────────── -->
  <section class="uses container section-gap" aria-labelledby="uses-heading">
    <h2 class="section-heading" id="uses-heading">Common Uses for Quitclaim Deeds</h2>
    <p class="section-intro">
      Quitclaim deeds are designed for transfers between parties who know and trust each other's ownership situation. Here are the most common scenarios.
    </p>
    <div class="use-cards">
      <a href="/quitclaim-deed/for-divorce/" class="use-card">
        <div class="use-card__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="use-card__title">Quitclaim Deed for Divorce</h3>
        <p class="use-card__desc">Transfer property between spouses during or after divorce proceedings. Includes guidance on the mortgage — which the deed alone does not resolve.</p>
        <span class="use-card__link" aria-hidden="true">Learn more &rarr;</span>
      </a>

      <a href="/quitclaim-deed/florida/" class="use-card">
        <div class="use-card__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <h3 class="use-card__title">Florida Quitclaim Deed</h3>
        <p class="use-card__desc">Florida requires two witnesses plus a notary under Fla. Stat. § 689.01. Homestead property has additional spouse-joinder requirements. Get the correct form.</p>
        <span class="use-card__link" aria-hidden="true">Learn more &rarr;</span>
      </a>

      <a href="/quitclaim-deed/california/parents-to-children/" class="use-card">
        <div class="use-card__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
        </div>
        <h3 class="use-card__title">California: Parents to Children</h3>
        <p class="use-card__desc">California Prop 19 (effective Feb. 16, 2021) changed the property tax reassessment exclusion for parent-to-child transfers significantly. Get Prop 19-compliant guidance.</p>
        <span class="use-card__link" aria-hidden="true">Learn more &rarr;</span>
      </a>

      <a href="/quitclaim-deed-form/" class="use-card">
        <div class="use-card__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <h3 class="use-card__title">Quitclaim Deed Form</h3>
        <p class="use-card__desc">Need the form itself? The full quitclaim deed generator lets you create, preview, and download a state-compliant deed for any of the 50 states.</p>
        <span class="use-card__link" aria-hidden="true">Go to form &rarr;</span>
      </a>

      <a href="/what-is-a-quitclaim-deed/" class="use-card">
        <div class="use-card__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h3 class="use-card__title">What Is a Quitclaim Deed?</h3>
        <p class="use-card__desc">Not sure if you need a quitclaim deed, a warranty deed, or a grant deed? Our guide explains the differences, the risks, and the common mistakes.</p>
        <span class="use-card__link" aria-hidden="true">Read the guide &rarr;</span>
      </a>

      <a href="/quitclaim-deed/" class="use-card">
        <div class="use-card__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
        </div>
        <h3 class="use-card__title">All 50 State Guides</h3>
        <p class="use-card__desc">State-specific requirements, recording fees, documentary stamp tax rules, and witness and notary requirements for all 50 states. Find your state.</p>
        <span class="use-card__link" aria-hidden="true">Browse all states &rarr;</span>
      </a>
    </div>
  </section>

  <!-- ── FAQ ────────────────────────────────────────────────────────────── -->
  <section class="container section-gap">
    <FAQ items={faqItems} />
  </section>

  <!-- ── Bottom CTA ─────────────────────────────────────────────────────── -->
  <section class="cta-band" aria-labelledby="cta-band-heading">
    <div class="cta-band__noise" aria-hidden="true"></div>
    <div class="container cta-band__inner">
      <p class="cta-band__label">State-specific • Notary-ready • Instant PDF</p>
      <h2 class="cta-band__heading" id="cta-band-heading">Ready to create your quitclaim deed?</h2>
      <p class="cta-band__sub">
        $19.97 — one-time payment, taxes included. Download the ready-to-sign PDF instantly. Correct witness blocks, notary language, and recording instructions included.
      </p>
      <a href="#generator" class="btn-primary cta-band__btn">Get My Deed — $19.97</a>
      <p class="cta-band__disclaimer">Not a law firm. Not legal advice. For informational purposes only.</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Section rhythm ────────────────────────────────────────────────────── */
  .section-gap {
    padding-top: clamp(5rem, 8vw, 8rem);
    padding-bottom: clamp(5rem, 8vw, 8rem);
  }

  .section-heading {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
