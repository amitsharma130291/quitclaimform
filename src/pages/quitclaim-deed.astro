  },
  {
    label: 'Lender acceptance',
    values: [
      'Typically rejected for purchase transactions',
      'Required by most mortgage lenders',
      'Acceptable for many commercial loans',
    ],
  },
];

const stateTableHeaders = ['Witnesses', 'Transfer Tax', 'Notable Requirement'];
const stateTableRows = [
