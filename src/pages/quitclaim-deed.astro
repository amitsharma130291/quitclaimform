  { label: 'Florida', values: ['2', '$0.70 per $100', 'Homestead property: non-titled spouse must also sign (Fla. Const. art. X, § 4)'] },
  { label: 'Texas', values: ['None', 'None', 'Both spouses must sign on community property (Tex. Fam. Code § 3.102)'] },
  { label: 'Michigan', values: ['None', '$3.75 per $500 (state) + county levy', 'Michigan requires a state equalization form on most transfers'] },
  { label: 'New York', values: ['None', '$0.50 per $500 (state) + NYC additional taxes', 'NYC mansion tax on transfers of $1M+'] },
  { label: 'Georgia', values: ['1', '$0.10 per $100', 'Transfer-on-Death Deed now available (O.C.G.A. § 44-17-1, effective 2024)'] },
];

const schema = [
  {
