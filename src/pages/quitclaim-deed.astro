const title = 'Quitclaim Deed: What It Is, When to Use One, and How to File It';
const description =
  'A quitclaim deed transfers your property interest to another person — no title guarantee. Learn when it\'s the right choice, how it differs from a warranty deed, and what state law requires before you sign.';

const faqItems = [
  {
    question: 'What is a quitclaim deed used for?',
    answer:
      'A quitclaim deed transfers whatever ownership interest the grantor currently holds to the grantee, with no warranty of clear title. It is used between parties who already know each other\'s ownership situation: spouses dividing property in a divorce, parents gifting a home to a child, individuals transferring property into a trust or LLC, and owners correcting title errors. It is not used for arm\'s-length sales to unrelated buyers.',
  },
  {
    question: 'Does a quitclaim deed remove me from the mortgage?',
    answer:
      'No. A quitclaim deed is a title document, not a mortgage document. It transfers ownership — it does not change the loan. The grantor remains personally liable on any mortgage secured by the property until the lender refinances the loan in the remaining party\'s name or formally releases the departing borrower.',
  },
  {
    question: 'Is a quitclaim deed legal in my state?',
    answer:
      'Yes. Quitclaim deeds are recognized in all 50 states. The requirements — signature blocks, witnesses, accompanying documents, transfer taxes — differ by state, but the deed type is valid everywhere.',
  },
  {
    question: 'Do I need an attorney to prepare a quitclaim deed?',
    answer:
      'Not in most states for routine transfers. However, legal advice is strongly recommended when the transfer involves a mortgage, is part of a divorce, concerns California property subject to Prop 19, transfers into or out of a trust, or involves any dispute about ownership. A deed prepared incorrectly may not be rejected by the recorder — and that is the dangerous outcome, not rejection.',
  },
  {
    question: 'What is the difference between a quitclaim deed and a warranty deed?',
    answer:
      'A warranty deed guarantees that the grantor holds clear title and will defend the grantee against future title claims. A quitclaim deed makes no such promise. Use a warranty deed when a buyer is paying market value and needs to rely on the grantor\'s title representations. Use a quitclaim deed when the parties know each other\'s ownership situation and a title guarantee is not needed.',
  },
  {
    question: 'How much does it cost to record a quitclaim deed?',
    answer:
      'Recording fees run $10–$30 for the first page, plus $5–$15 per additional page in most counties. Many states also impose a documentary transfer tax based on the stated consideration or the property\'s value. Total out-of-pocket cost for a simple family transfer in most states: $15–$75 for recording and the deed itself, not counting attorney fees if used.',
  },
  {
    question: 'What happens if I make a mistake on a quitclaim deed?',
    answer:
      'Minor errors can typically be corrected with a new corrective quitclaim deed referencing the original. Significant errors — a wrong legal description, reversed grantor and grantee, missing required signatures — require a new deed from the original grantor. If the original grantor is unavailable, correcting the title may require a quiet title action in court.',
  },
];

const whenToUseHeaders = ['Use a Quitclaim Deed?'];
const whenToUseRows = [
  { label: 'Divorce: one spouse transfers their interest to the other', values: ['Yes'] },
  { label: 'Adding a spouse or partner to an existing title', values: ['Yes'] },
  { label: 'Removing a name after divorce or separation', values: ['Yes'] },
  { label: 'Parent transferring property to a child as a gift', values: ['Yes'] },
  { label: 'Transferring property into a revocable living trust', values: ['Yes'] },
  { label: 'Moving property from an individual name into an LLC', values: ['Yes'] },
  { label: 'Correcting a title error (wrong name, misspelling, old name)', values: ['Yes'] },
  { label: 'Selling a home to an unrelated buyer paying market value', values: ['No — use a warranty deed'] },
  { label: 'Purchase transaction with a mortgage lender involved', values: ['No — lenders require a warranty deed'] },
  { label: 'Transfer where the title history is uncertain or disputed', values: ['No — resolve the title issue first'] },
];

const deedComparisonHeaders = ['Quitclaim Deed', 'General Warranty Deed', 'Special Warranty Deed'];
const deedComparisonRows = [
  {
    label: 'What the grantor promises',
    values: [
      'Nothing — transfers only whatever interest the grantor holds',
      'Clear title, back through the entire chain of ownership',
      'Clear title only during the grantor\'s period of ownership',
    ],
  },
  {
    label: 'Who uses it',
