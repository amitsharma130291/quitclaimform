    />
    <ProcessStep
      number={2}
      title="Review the mortgage and loan documents"
      description="If there is an outstanding loan, review the mortgage and loan documents before recording. Consider any doc stamp tax implications. Contact the lender if the loan terms, refinance plans, or lender procedures make notification appropriate."
    />
    <ProcessStep
      number={3}
      title="Sign in the presence of two subscribing witnesses and arrange the acknowledgment"
      description="The grantor signs in the presence of two subscribing witnesses as required by §689.01. The witnesses then sign the deed. A notary completes the acknowledgment block required for recording under §695.03."
    />
    <ProcessStep
      number={4}
      title="Record the deed with the county clerk"
      description="Take the executed original to the clerk of court in the county where the property is located. Pay any applicable documentary stamp tax and recording fees."
    />
    <ProcessStep
      number={5}
      title="Update your homestead exemption"
      description="Bring a copy of the recorded deed to the county property appraiser's office and confirm whether an updated exemption application is required."
      isLast={true}
    />
  </div>

  <!-- Filing Checklist -->
  <FilingChecklist
