const faqItems = [
  {
    question: 'Does a Florida quitclaim deed need to be notarized?',
    answer:
      'Florida §689.01 requires execution in the presence of two subscribing witnesses. For recording, execution generally must also be acknowledged or proved as provided in §695.03. In practice, a Florida notary executes a formal acknowledgment block — not just a signature and seal — to satisfy the recording requirement under §695.03.',
  },
  {
    question: 'Can a family member serve as a witness in Florida?',
    answer:
      'Yes. Florida §689.01 requires subscribing witnesses; witnesses do not need to be disinterested parties. As a matter of conservative signing practice, avoid using the grantee as a witness. Follow the execution format required by the recorder and applicable Florida law.',
  },
  {
    question: 'How much does it cost to record a quitclaim deed in Florida?',
    answer:
      'Recording fees vary by county. Check the clerk/comptroller\'s current fee schedule before filing. You also owe documentary stamp tax under Fla. Stat. § 201.02 — $0.70 per $100 of consideration when consideration is stated or an encumbrance constitutes consideration; no documentary stamps are generally owed on a true zero-consideration transfer with no encumbrance.',
  },
  {
    question: 'What is the documentary stamp tax and when does it apply?',
    answer:
      'Under Fla. Stat. § 201.02, the documentary stamp tax is $0.70 per $100 of consideration. It applies when actual monetary consideration is stated, and also when there is a mortgage, lien, or other encumbrance on the property — such indebtedness constitutes consideration whether or not the grantee formally assumes it. For a transfer with genuinely no consideration and no encumbrance, documentary stamps may not apply. Where the deed states nominal consideration (such as $1 or $10), the $0.70 minimum may apply on that stated amount.',
  },
  {
    question: 'Can I write my own legal description on the deed?',
    answer:
      'Do not compose your own — copy it exactly from the existing deed or official county records. Any error in the legal description can create a title defect that is expensive to correct.',
  },
  {
    question: 'Where do I file a quitclaim deed in Florida?',
    answer:
      'With the Clerk of the Circuit Court in the county where the property is physically located — not where you live and not where you signed.',
  },
  {
    question: "Is it 'Florida quit claim deed form' or 'Florida quitclaim deed form'?",
    answer:
      "Both spellings refer to the same document. Florida courts and statutes use 'quitclaim deed' as one word, which is the current legal standard. You may see 'quit claim deed form' (two words) in older documents — both are acceptable.",
  },
  {
    question: 'Does a quitclaim deed convey clear title in Florida?',
    answer:
      'No. A quitclaim deed transfers only whatever interest the grantor actually has, with no warranties of title. If the grantor\'s title is clouded, the grantee receives the same clouded title. This is why quitclaims are used for family transfers, divorce settlements, and trust conveyances — situations where the parties know the title history and trust each other.',
  },
];

const docStampHeaders = ['Scenario', 'Doc Stamp Tax Applies?', 'Rate'];
