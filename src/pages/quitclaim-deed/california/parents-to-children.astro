---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CitableAnswerBlock from '../../../components/CitableAnswerBlock.astro';
import DeedForm from '../../../components/DeedForm.astro';
import FAQ from '../../../components/FAQ.astro';
import Disclaimer from '../../../components/Disclaimer.astro';

const faqItems = [
  {
    question: 'Does California use quitclaim deeds for parent-to-child transfers?',
    answer: 'Yes, but California property law is nuanced. California does not have a statutory "quitclaim deed" form in the same sense as other states. A grant deed is more common for sales, but a quitclaim deed (or interspousal/intrafamily deed) is valid for parent-to-child transfers. Consult a California real estate attorney for your specific situation.',
  },
  {
    question: 'What is Proposition 19 and how does it affect parent-to-child transfers in California?',
    answer: 'California Proposition 19 (effective February 16, 2021) significantly changed parent-to-child property tax reassessment exclusions. The exclusion now applies only if the child makes the inherited property their primary residence within one year. The exclusion is also capped. This is a major tax consideration for California parent-to-child transfers.',
  },
  {
    question: 'Do I need to file a PCOR when transferring property from parents to children in California?',
    answer: 'Yes. California requires a Preliminary Change of Ownership Report (PCOR) to be filed with the county assessor when a deed is recorded. This determines whether a property tax reassessment exclusion applies.',
  },
  {
    question: 'Are parent-to-child transfers in California exempt from transfer tax?',
    answer: 'California documentary transfer tax ($1.10 per $1,000 of value) generally applies to transfers, but many family transfers (gifts with no consideration) are exempt. The PCOR and any exemption claim must be filed at the time of recording.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "California Quitclaim Deed: Parents to Children",
  "description": "Transfer property from parents to children in California. Covers Proposition 19 tax implications, PCOR requirements, and how to complete the deed.",
};
---
<BaseLayout
  title="California Quitclaim Deed: Parents to Children — Prop 19, PCOR, and How-To"
  description="Transfer property from parents to children in California. Understand Proposition 19 tax implications, PCOR filing requirements, and generate a compliant deed PDF."
  canonical="/quitclaim-deed/california/parents-to-children"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <nav class="text-sm text-gray-500 mb-6">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span class="mx-2">/</span>
    <a href="/quitclaim-deed-form" class="hover:text-blue-600">Quitclaim Deed Form</a>
    <span class="mx-2">/</span>
    <span>California: Parents to Children</span>
  </nav>

  <h1 class="text-3xl font-bold mb-6">California Quitclaim Deed: Parents to Children</h1>

  <CitableAnswerBlock
    question="What are the key considerations for California parent-to-child property transfers?"
    answer="California parent-to-child transfers involve both deed execution requirements and significant property tax implications under Proposition 19. The deed must be notarized and recorded with the county recorder. A Preliminary Change of Ownership Report (PCOR) is required. Prop 19 limits the property tax reassessment exclusion to cases where the child uses the property as their primary residence within one year."
    source="California Civil Code § 1091; Proposition 19 (Cal. Const. Art. XIII A, § 2.1); Cal. Rev. & Tax. Code § 63.1"
  />

  <h2 class="text-2xl font-bold mt-8 mb-4">California Parent-to-Child Transfer Requirements</h2>
  <div class="overflow-x-auto mb-6">
    <table class="w-full text-sm border-collapse">
      <tbody>
        <tr class="bg-gray-50">
          <td class="p-3 border border-gray-200 font-medium w-1/3">Witnesses Required</td>
          <td class="p-3 border border-gray-200">None (notary only)</td>
        </tr>
        <tr>
          <td class="p-3 border border-gray-200 font-medium">Notarization</td>
          <td class="p-3 border border-gray-200">Required</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="p-3 border border-gray-200 font-medium">Recording Office</td>
          <td class="p-3 border border-gray-200">County Recorder (county where property is located)</td>
        </tr>
        <tr>
          <td class="p-3 border border-gray-200 font-medium">PCOR Required</td>
          <td class="p-3 border border-gray-200">Yes — file with county assessor at time of recording</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="p-3 border border-gray-200 font-medium">Prop 19 Exclusion</td>
          <td class="p-3 border border-gray-200">Child must make property primary residence within 1 year</td>
        </tr>
        <tr>
          <td class="p-3 border border-gray-200 font-medium">Transfer Tax</td>
          <td class="p-3 border border-gray-200">$1.10 per $1,000 of value (gifts may be exempt)</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="bg-amber-50 border border-amber-300 rounded-lg p-5 my-6">
    <h3 class="font-bold text-amber-900 mb-2">Important: Proposition 19 Changes</h3>
    <p class="text-amber-800 text-sm">
      California Proposition 19 (effective February 16, 2021) significantly limited the parent-to-child
      property tax reassessment exclusion. Under Prop 19, the child must occupy the transferred property
      as their primary residence within one year for the exclusion to apply. The tax savings from the
      exclusion are also capped. If your child will not occupy the property as their primary residence,
      a property tax reassessment (often a significant increase) will occur. Consult a California tax
      professional or estate planning attorney before proceeding.
    </p>
  </div>

  <h2 class="text-2xl font-bold mt-10 mb-4">Generate Your California Deed</h2>
  <DeedForm />

  <Disclaimer />

  <FAQ items={faqItems} />
</BaseLayout>
