---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CitableAnswerBlock from '../../components/CitableAnswerBlock.astro';
import DeedForm from '../../components/DeedForm.astro';
import FAQ from '../../components/FAQ.astro';
import Disclaimer from '../../components/Disclaimer.astro';

const faqItems = [
  {
    question: 'How many witnesses are required for a Florida quitclaim deed?',
    answer: 'Florida requires two witnesses on a quitclaim deed, in addition to notarization. Both witnesses must be present when the grantor signs. The notary public may serve as one of the two required witnesses, signing in both capacities.',
  },
  {
    question: 'How much does it cost to record a quitclaim deed in Florida?',
    answer: 'Florida recording fees are $10.00 for the first page and $8.50 for each additional page. Fees may vary slightly by county. Most quitclaim deeds are 2–3 pages, so expect $18.50–$27.00 in recording fees.',
  },
  {
    question: 'Is Florida documentary stamp tax due on a quitclaim deed?',
    answer: 'Florida charges documentary stamp tax on deeds: $0.70 per $100 of consideration (or $0.35/$100 in Miami-Dade County). If the deed is a gift or family transfer with no monetary consideration, the minimum tax is $0.70. Consult a title company or attorney for your specific situation.',
  },
  {
    question: 'Does my spouse need to sign a Florida quitclaim deed?',
    answer: 'If the property is Florida homestead and the grantor\'s spouse is not on the title, the spouse must join in signing the deed. This is Florida\'s homestead joinder requirement, unique among most states.',
  },
  {
    question: 'Where do I record a Florida quitclaim deed?',
    answer: 'Record your Florida quitclaim deed with the Clerk of Court in the county where the property is located. Each county has its own clerk\'s office. Major county offices include Miami-Dade Clerk of Courts, Broward County Records Division, and Hillsborough County Clerk of Court.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Florida Quitclaim Deed",
  "description": "Florida quitclaim deed requirements: 2 witnesses, notarization, documentary stamp tax. Generate a state-compliant Florida quitclaim deed PDF.",
};
---
<BaseLayout
  title="Florida Quitclaim Deed — Requirements, Fees, and Free Generator"
  description="Florida quitclaim deed requirements: 2 witnesses plus notarization, $10 first-page recording fee, documentary stamp tax. Generate a compliant Florida deed PDF for $14.99."
  canonical="/quitclaim-deed/florida"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <nav class="text-sm text-gray-500 mb-6">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span class="mx-2">/</span>
    <a href="/quitclaim-deed-form" class="hover:text-blue-600">Quitclaim Deed Form</a>
    <span class="mx-2">/</span>
    <span>Florida</span>
  </nav>

  <h1 class="text-3xl font-bold mb-6">Florida Quitclaim Deed</h1>

  <CitableAnswerBlock
    question="What are Florida's quitclaim deed requirements?"
    answer="Florida requires a quitclaim deed to be signed by the grantor in the presence of two witnesses and a notary public. The deed must be recorded with the Clerk of Court in the county where the property is located. Documentary stamp tax of $0.70 per $100 of consideration applies (Fla. Stat. § 689.01, § 695.26)."
    source="Fla. Stat. § 689.01 (2026); Fla. Stat. § 695.26; Florida Department of Revenue"
  />

  <h2 class="text-2xl font-bold mt-8 mb-4">Florida Quitclaim Deed Requirements at a Glance</h2>
  <div class="overflow-x-auto mb-6">
    <table class="w-full text-sm border-collapse">
      <tbody>
        <tr class="bg-gray-50">
          <td class="p-3 border border-gray-200 font-medium w-1/3">Witnesses Required</td>
          <td class="p-3 border border-gray-200">2 witnesses (notary may serve as one)</td>
        </tr>
        <tr>
          <td class="p-3 border border-gray-200 font-medium">Notarization</td>
          <td class="p-3 border border-gray-200">Required</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="p-3 border border-gray-200 font-medium">Recording Office</td>
          <td class="p-3 border border-gray-200">Clerk of Court (county where property is located)</td>
        </tr>
        <tr>
          <td class="p-3 border border-gray-200 font-medium">Recording Fee</td>
          <td class="p-3 border border-gray-200">$10.00 first page + $8.50 each additional page</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="p-3 border border-gray-200 font-medium">Documentary Stamp Tax</td>
          <td class="p-3 border border-gray-200">$0.70 per $100 of consideration (min. $0.70)</td>
        </tr>
        <tr>
          <td class="p-3 border border-gray-200 font-medium">Homestead Joinder</td>
          <td class="p-3 border border-gray-200">Non-titled spouse must sign if homestead property</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="p-3 border border-gray-200 font-medium">Statutory Authority</td>
          <td class="p-3 border border-gray-200">Fla. Stat. § 689.01</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 class="text-2xl font-bold mt-10 mb-4">Generate Your Florida Quitclaim Deed</h2>
  <DeedForm />

  <Disclaimer />

  <FAQ items={faqItems} />
</BaseLayout>
