---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact Us — WhatIsAQuitclaimDeed.com';
const description =
  'Contact WhatIsAQuitclaimDeed.com with questions, feedback, or to report an error. We respond to all messages within 1–2 business days.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  url: 'https://whatisaquitclaimdeed.com/contact/',
  description,
};
---

<BaseLayout title={title} description={description} canonical="/contact/">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="page-content">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Contact</span>
  </nav>

  <h1 class="page-h1">Contact Us</h1>

  <p class="lead">
    Have a question, found an error, or want to leave feedback? Fill out the form below and we will
    get back to you within 1–2 business days.
  </p>

  <div class="contact-layout">
    <div class="contact-form-wrap">
      <form class="contact-form" id="contact-form" novalidate>
        <div class="form-group">
          <label for="contact-name">Your Name <span class="required" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="contact-name"
            name="name"
            autocomplete="name"
            placeholder="Jane Smith"
            required
          />
        </div>

        <div class="form-group">
          <label for="contact-email">Email Address <span class="required" aria-hidden="true">*</span></label>
          <input
            type="email"
            id="contact-email"
            name="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
        </div>

        <div class="form-group">
          <label for="contact-subject">Subject</label>
          <input
            type="text"
            id="contact-subject"
            name="subject"
            placeholder="Question about my deed form"
          />
        </div>

        <div class="form-group">
          <label for="contact-message">Message <span class="required" aria-hidden="true">*</span></label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            placeholder="Describe your question or issue..."
            required
          ></textarea>
        </div>

        <div class="form-status" id="form-status" aria-live="polite" hidden></div>

        <button type="submit" class="btn-submit" id="submit-btn">
          Send Message
        </button>

        <p class="form-note">
          We do not provide legal advice. For questions about your specific legal situation,
          please consult a licensed real estate attorney.
        </p>
      </form>
    </div>

    <div class="contact-sidebar">
      <div class="sidebar-card">
        <h2>Frequently Asked Questions</h2>
        <p>
          Many questions are answered in our guides. Before writing to us, you may find what
          you need here:
        </p>
        <ul>
          <li><a href="/what-is-a-quitclaim-deed/">What is a quitclaim deed?</a></li>
          <li><a href="/quitclaim-deed/for-divorce/">Quitclaim deed for divorce</a></li>
          <li><a href="/quitclaim-deed/florida/">Florida quitclaim deed requirements</a></li>
          <li><a href="/quitclaim-deed/california/parents-to-children/">California parent-to-child deed</a></li>
        </ul>
      </div>

      <div class="sidebar-card">
        <h2>Response Time</h2>
        <p>We respond to all messages within 1–2 business days.</p>
        <p>
          <strong>Note:</strong> We cannot provide legal advice or review your specific deed for
          legal sufficiency. For legal review, please consult a licensed attorney.
        </p>
      </div>
    </div>
  </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status || !submitBtn) return;

    const data = {
      name: (form.elements.namedItem('name') as HTMLInputElement)?.value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement)?.value.trim(),
      subject: (form.elements.namedItem('subject') as HTMLInputElement)?.value.trim(),
      message: (form.elements.namedItem('message') as HTMLTextAreaElement)?.value.trim(),
    };

    if (!data.name || !data.email || !data.message) {
      status.textContent = 'Please fill in all required fields.';
      status.className = 'form-status form-status--error';
      status.hidden = false;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';
    status.hidden = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await res.json();

      if (result.success) {
        status.textContent = 'Thank you! Your message has been sent. We will be in touch within 1–2 business days.';
        status.className = 'form-status form-status--success';
        status.hidden = false;
        form.reset();
      } else {
        status.textContent = result.error || 'Something went wrong. Please try again.';
        status.className = 'form-status form-status--error';
        status.hidden = false;
      }
    } catch {
      status.textContent = 'Network error. Please check your connection and try again.';
      status.className = 'form-status form-status--error';
      status.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    }
  });
</script>

<style>
  .page-content {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem clamp(1.25rem, 5vw, 3rem);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }
  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-teal);
    text-decoration: underline;
  }

  .page-h1 {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.15;
    margin-bottom: var(--space-5);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-8);
    max-width: 640px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-8);
    align-items: start;
  }

  @media (max-width: 767px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .required {
    color: #dc2626;
  }

  input[type="text"],
  input[type="email"],
  textarea {
    width: 100%;
    padding: 0.625rem var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    background: var(--color-surface);
    transition: border-color var(--duration-micro) var(--ease-standard);
    box-sizing: border-box;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-teal);
    box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
  }

  textarea {
    resize: vertical;
    min-height: 140px;
  }

  .form-status {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .form-status--success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
  }

  .form-status--error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }

  .btn-submit {
    padding: 0.75rem var(--space-6);
    background: var(--color-teal);
    color: #ffffff;
    font-size: var(--text-base);
    font-weight: 700;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
    align-self: flex-start;
    min-width: 160px;
  }

  .btn-submit:hover:not(:disabled) {
    background: var(--color-teal-hover);
    transform: translateY(-1px);
  }

  .btn-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .form-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Sidebar */
  .sidebar-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-5);
  }

  h2 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-3);
  }

  p:last-child {
    margin-bottom: 0;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
  }

  ul a {
    font-size: var(--text-sm);
    color: var(--color-teal);
    text-decoration: underline;
  }

  ul a:hover {
    color: var(--color-teal-hover);
  }
</style>
