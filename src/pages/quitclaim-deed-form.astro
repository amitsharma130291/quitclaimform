        <span class="qdf-cost-value">15–30 minutes</span>
      </div>
      <div class="qdf-cost-item">
        <span class="qdf-cost-label">Estimated recording cost</span>
        <span class="qdf-cost-value">$15–$50 + any transfer taxes</span>
      </div>
    </div>
  </section>

  <!-- ── Legal Disclaimer ───────────────────────────────────────────────────── -->
  <Disclaimer />

