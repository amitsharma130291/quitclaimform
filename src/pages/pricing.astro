---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';

const title = 'Pricing — WhatIsAQuitclaimDeed.com';
const description =
  'Get a free state-specific quitclaim deed, or add the Complete Filing Bundle ($19.97 incl. tax) with your county recording checklist, legal description guide, and 90-day re-download.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: 'https://whatisaquitclaimdeed.com/pricing/',
  description,
};

const faqItems = [
  {
    question: "What's the difference between downloading the deed and recording it?",
    answer:
      "Downloading gives you the signed document. Recording means filing it with your county recorder's office so it becomes part of the official property record. That's the step that legally transfers ownership. The Complete Filing Bundle walks you through exactly how to do that in your county.",
  },
  {
    question: 'Do I need to create an account to purchase?',
    answer:
      'No account required. You pay once, download immediately, and receive a receipt with your 90-day re-download link by email.',
  },
];
---

<BaseLayout title={title} description={description} canonical="/pricing/">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="page-content">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Pricing</span>
    </nav>

    <h1 class="page-h1">Get your quitclaim deed. Or get everything you need to record it.</h1>

    <!-- Pain section -->
    <section class="pain-section" aria-labelledby="pain-heading">
      <h2 class="pain-heading" id="pain-heading">Before you download</h2>

      <p class="pain-para">
        <strong>Downloading a deed and recording a deed are two different things.</strong> One is a
        file on your computer. The other is what actually transfers ownership in the eyes of the law.
      </p>

      <p class="pain-para">
        <strong>Most people find out the hard way that counties don't accept just any deed.</strong>
        Each county has its own requirements: a specific cover sheet, minimum font size and margin
        rules, a Transfer Tax Affidavit, sometimes a particular witness count. Bring the wrong
        document and it comes back to you. You pay the filing fee again. You wait again. And while
        the deed sits unrecorded, the transfer isn't legally done.
      </p>

      <p class="pain-para">
        <strong>The legal description is where people freeze.</strong> It's not the street address.
        It's a precise parcel description copied from the existing deed, and getting it wrong (or
        copying slightly the wrong text) is one of the most common reasons deeds get rejected or,
        worse, accepted with an error that causes problems later.
      </p>

      <p class="pain-para">
        <strong>Then there's everything after you sign.</strong> Notarisation, witnesses, transfer
        tax payment, filing order, tax assessor notification. Most people have no idea these steps
        exist until they're standing at the recorder's office without half of them done. And if you
        catch a typo after you've downloaded, with a single-download setup you're starting over from
        scratch.
      </p>
    </section>

    <!-- Two-column tier grid — paid card is DOM-first so it appears at top on mobile -->
    <div class="tiers-grid">

      <!-- Paid card (right on desktop, top on mobile) -->
      <div class="tier-card tier-card--paid">
        <div class="tier-header">
          <p class="paid-title">Complete Filing Bundle</p>
          <p class="paid-price">$19.97 <span class="paid-tax">taxes included</span></p>
          <p class="tier-subhead">Everything you need to actually get it recorded — not just downloaded.</p>
        </div>

        <ul class="tier-features">
          <li>
            <span class="feature-icon" aria-hidden="true">✓</span>
            <span>
              <strong>County-specific recording checklist:</strong> the exact cover sheet, margin
              requirements, Transfer Tax Affidavit, witness count, and filing fee for your county —
              not a generic list, your county
            </span>
          </li>
          <li>
            <span class="feature-icon" aria-hidden="true">✓</span>
            <span>
              <strong>90-day re-download:</strong> fix a typo, reprint, or pull a fresh copy any
              time in the next 90 days
            </span>
          </li>
          <li>
            <span class="feature-icon" aria-hidden="true">✓</span>
            <span>
              <strong>Legal description guide:</strong> where to find it on your existing deed,
              what to copy word for word, and what not to touch
            </span>
          </li>
          <li>
            <span class="feature-icon" aria-hidden="true">✓</span>
            <span>
              <strong>Post-signing step-by-step guide:</strong> notarise, gather witnesses, pay
              transfer tax, file in the right order, notify the tax assessor — state-specific, not
              generic
            </span>
          </li>
          <li>
            <span class="feature-icon" aria-hidden="true">✓</span>
            <span>
              <strong>Transfer tax calculator:</strong> enter your county, get the exact dollar
              amount to bring to the recorder's office
            </span>
          </li>
        </ul>

        <p class="paid-instant-note">Delivered as an instant PDF download — no account required.</p>

        <!-- Email input + buy button -->
        <div class="buy-form" id="buy-form">
          <label for="buyer-email" class="buy-label">Your email address</label>
          <input
            type="email"
            id="buyer-email"
            name="email"
            class="buy-email-input"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
          <p class="email-why">We'll send your download link and receipt here.</p>

          <button
            class="tier-cta tier-cta--paid"
            id="buy-btn"
            type="button"
          >
            Get the Complete Filing Bundle — $19.97
          </button>
          <p class="buy-error" id="buy-error" role="alert" aria-live="polite" style="display:none"></p>
        </div>

        <p class="paid-muted">The deed is free. The part where the county actually accepts it is $19.97.</p>
        <p class="paid-trust">$19.97 total — taxes included. One-time payment. Instant access. No subscription.</p>
        <p class="paid-guarantee">If it doesn't cover your county, email us for a full refund.</p>
      </div>

      <!-- Free card (left on desktop, bottom on mobile) -->
      <div class="tier-card tier-card--free">
        <div class="tier-header">
          <p class="free-label">Free Deed</p>
          <p class="free-price">$0</p>
        </div>

        <ul class="tier-features tier-features--free">
          <li>
            <span class="feature-icon feature-icon--free" aria-hidden="true">✓</span>
            State-specific deed for all 50 states
          </li>
          <li>
            <span class="feature-icon feature-icon--free" aria-hidden="true">✓</span>
            Correct witness blocks and notary language built in
          </li>
          <li>
            <span class="feature-icon feature-icon--free" aria-hidden="true">✓</span>
            Instant PDF download
          </li>
          <li>
            <span class="feature-icon feature-icon--free" aria-hidden="true">✓</span>
            No account required — no credit card
          </li>
        </ul>

        <a href="/quitclaim-deed-form/" class="tier-cta tier-cta--free">
          Get your free deed
        </a>
      </div>

    </div>

    <!-- FAQ -->
    <FAQ items={faqItems} />

  </div>

<script>
  const buyBtn = document.getElementById('buy-btn') as HTMLButtonElement | null;
  const emailInput = document.getElementById('buyer-email') as HTMLInputElement | null;
  const errorEl = document.getElementById('buy-error') as HTMLElement | null;

  if (buyBtn && emailInput) {
    buyBtn.addEventListener('click', async () => {
      const email = emailInput.value.trim();

      if (!email || !email.includes('@')) {
        showError('Please enter a valid email address.');
        emailInput.focus();
        return;
      }

      hideError();
      setLoading(true);

      try {
        const resp = await fetch('/api/create-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await resp.json();

        if (!resp.ok || !data.checkoutUrl) {
          showError(data.error ?? 'Something went wrong. Please try again.');
          setLoading(false);
          return;
        }

        // Redirect to Dodo Payments checkout
        window.location.href = data.checkoutUrl;
      } catch (err) {
        console.error('Checkout error:', err);
        showError('Network error. Please check your connection and try again.');
        setLoading(false);
      }
    });

    // Allow pressing Enter in the email field to trigger checkout
    emailInput.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') buyBtn.click();
    });
  }

  function showError(msg: string) {
    if (errorEl) {
      errorEl.textContent = msg;
      errorEl.style.display = 'block';
    }
  }

  function hideError() {
    if (errorEl) {
      errorEl.style.display = 'none';
      errorEl.textContent = '';
    }
  }

  function setLoading(loading: boolean) {
    if (!buyBtn) return;
    if (loading) {
      buyBtn.textContent = 'Redirecting to checkout…';
      buyBtn.disabled = true;
      buyBtn.style.opacity = '0.75';
      buyBtn.style.cursor = 'wait';
    } else {
      buyBtn.textContent = 'Get the Complete Filing Bundle — $19.97';
      buyBtn.disabled = false;
      buyBtn.style.opacity = '1';
      buyBtn.style.cursor = 'pointer';
    }
  }
</script>
</BaseLayout>

<style>
  .page-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem clamp(1.25rem, 5vw, 3rem);
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }
  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-teal);
    text-decoration: underline;
  }

  /* H1 */
  .page-h1 {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.15;
    margin-bottom: var(--space-7);
    max-width: 760px;
  }

  /* Pain section */
  .pain-section {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .pain-heading {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-5);
  }
  .pain-para {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin: 0 0 var(--space-4) 0;
  }
  .pain-para:last-child {
    margin-bottom: 0;
  }
  .pain-para strong {
    color: var(--color-text-primary);
  }

  /* Tier grid */
  .tiers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
    align-items: start;
  }
  .tier-card--free  { order: 1; }
  .tier-card--paid  { order: 2; }

  @media (max-width: 640px) {
    .tiers-grid { grid-template-columns: 1fr; }
    .tier-card--paid { order: 1; }
    .tier-card--free { order: 2; }
  }

  /* Card base */
  .tier-card {
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  /* Free card */
  .tier-card--free {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  /* Paid card */
  .tier-card--paid {
    background: linear-gradient(160deg, #fffbeb 0%, #fef3c7 50%, #fff8e7 100%);
    border: 2px solid #d97706;
    box-shadow: 0 4px 24px rgba(217, 119, 6, 0.18);
  }

  /* Free card header */
  .free-label {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2) 0;
  }
  .free-price {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1;
    margin: 0 0 var(--space-5) 0;
  }

  /* Paid card header */
  .paid-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: #92400e;
    line-height: 1.25;
    margin: 0 0 var(--space-1) 0;
  }
  .paid-price {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: #b45309;
    margin: 0 0 var(--space-2) 0;
    line-height: 1.2;
  }
  .paid-tax {
    font-size: 0.85rem;
    font-weight: 500;
    color: #78350f;
    vertical-align: middle;
  }
  .tier-subhead {
    font-size: var(--text-base);
    color: #78350f;
    font-weight: 500;
    line-height: 1.5;
    margin: 0 0 var(--space-5) 0;
  }

  /* Feature lists */
  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }
  .tier-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .feature-icon {
    flex-shrink: 0;
    font-weight: 700;
    color: #b45309;
    margin-top: 0.1em;
  }
  .feature-icon--free {
    color: var(--color-teal);
  }

  /* Paid instant-download note */
  .paid-instant-note {
    font-size: var(--text-sm);
    color: #78350f;
    font-weight: 500;
    margin: 0 0 var(--space-4) 0;
    padding: 0.6rem var(--space-4);
    background: rgba(217, 119, 6, 0.08);
    border-radius: var(--radius-md);
    border-left: 3px solid #d97706;
  }

  /* Buy form */
  .buy-form {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: var(--space-4);
  }
  .buy-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: #92400e;
  }
  .buy-email-input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1.5px solid #d97706;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-family: var(--font-body);
    background: #fff;
    color: var(--color-text-primary);
    box-sizing: border-box;
    transition: border-color var(--duration-fast);
  }
  .buy-email-input:focus {
    outline: none;
    border-color: #b45309;
    box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.15);
  }
  .buy-email-input::placeholder {
    color: #b6a87b;
  }
  .email-why {
    font-size: 0.75rem;
    color: #92400e;
    margin: 0;
  }

  /* CTAs */
  .tier-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.875rem var(--space-5);
    font-size: var(--text-base);
    font-weight: 700;
    font-family: var(--font-body);
    border-radius: var(--radius-md);
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
    margin-top: 0.25rem;
  }

  /* Free */
  .tier-cta--free {
    background: transparent;
    color: var(--color-teal);
    border: 2px solid var(--color-teal);
    margin-top: auto;
  }
  .tier-cta--free:hover {
    background: var(--color-teal-light);
  }

  /* Paid */
  .tier-cta--paid {
    background: #d97706;
    color: #ffffff;
  }
  .tier-cta--paid:hover:not(:disabled) {
    background: #b45309;
  }

  /* Error */
  .buy-error {
    font-size: var(--text-sm);
    color: #dc2626;
    margin-top: 0.25rem;
    line-height: 1.5;
  }

  /* Below paid CTA */
  .paid-muted {
    font-size: var(--text-sm);
    color: #92400e;
    text-align: center;
    margin: var(--space-3) 0 0 0;
    line-height: 1.5;
  }
  .paid-trust {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    margin: var(--space-2) 0 0 0;
    line-height: 1.5;
  }
  .paid-guarantee {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    margin: 0.375rem 0 0 0;
    line-height: 1.5;
    font-style: italic;
  }
</style>
