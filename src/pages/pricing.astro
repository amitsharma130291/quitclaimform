---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';

const title = 'Pricing — WhatIsAQuitclaimDeed.com';
const description =
  'Get a state-specific quitclaim deed for $19.97 — all 50 states, correct notary language, county recording instructions, and instant download. Taxes included.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: 'https://whatisaquitclaimdeed.com/pricing/',
  description,
};

const faqItems = [
  {
    question: "What\'s the difference between downloading the deed and recording it?",
    answer:
      "Downloading gives you the signed document. Recording means filing it with your county recorder\'s office so it becomes part of the official property record. That\'s the step that legally transfers ownership. Your deed includes state-specific recording instructions so you know exactly what to do.",
  },
  {
    question: 'Can I re-download my deed after purchase?',
    answer:
      'Yes. Your deed is available for re-download for 90 days after purchase. If you spot a typo or need a fresh copy, just use the link in your confirmation email.',
  },
];
---

<BaseLayout title={title} description={description} canonical="/pricing/">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="page-content">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Pricing</span>
    </nav>

    <h1 class="page-h1">Quitclaim Deed — $19.97</h1>

    <!-- Single product card -->
    <div class="product-card">
      <div class="product-card__header">
        <p class="product-name">Quitclaim Deed</p>
        <p class="product-price">$19.97 <span class="product-price__note">taxes included</span></p>
        <p class="product-tagline">State-specific, notary-ready, instant download.</p>
      </div>

      <ul class="product-features">
        <li>
          <span class="feature-icon" aria-hidden="true">✓</span>
          <span><strong>All 50 states</strong> — correct statutory language for the state where your property is located</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">✓</span>
          <span><strong>Correct notary acknowledgment language</strong> — applied automatically for your state</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">✓</span>
          <span><strong>Witness signature blocks</strong> — FL, GA, SC, TN, CT, VT, LA and more, as required by state law</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">✓</span>
          <span><strong>County recording instructions</strong> — what to bring, how to file, and what fees to expect</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">✓</span>
          <span><strong>AZ / FL / TX / AK statutory language blocks</strong> — built in for states with specific deed requirements</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">✓</span>
          <span><strong>Instant download</strong> — immediately after checkout</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">✓</span>
          <span><strong>90-day re-download</strong> — fix a typo or reprint any time within 90 days</span>
        </li>
      </ul>

      <a href="/quitclaim-deed-form/" class="product-cta">
        Get My Deed — $19.97
      </a>
      <p class="product-trust">One-time payment. No subscription. Taxes included.</p>
      <p class="product-guarantee">If your state or county isn't covered, email us for a full refund.</p>
    </div>

    <!-- FAQ -->
    <FAQ items={faqItems} />

  </div>
</BaseLayout>

<style>
  .page-content {
    max-width: 640px;
    margin: 0 auto;
    padding: 3rem clamp(1.25rem, 5vw, 3rem);
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }
  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-teal);
    text-decoration: underline;
  }

  /* H1 */
  .page-h1 {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.15;
    margin-bottom: var(--space-7);
    max-width: 760px;
  }

  /* Product card */
  .product-card {
    background: linear-gradient(160deg, #fffbeb 0%, #fef3c7 50%, #fff8e7 100%);
    border: 2px solid #d97706;
    border-radius: var(--radius-xl);
    padding: var(--space-7);
    box-shadow: 0 4px 24px rgba(217, 119, 6, 0.18);
    margin-bottom: var(--space-8);
  }

  .product-card__header {
    margin-bottom: var(--space-6);
  }

  .product-name {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #92400e;
    margin: 0 0 var(--space-2) 0;
  }

  .product-price {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 800;
    color: #78350f;
    line-height: 1;
    margin: 0 0 var(--space-2) 0;
  }

  .product-price__note {
    font-size: var(--text-base);
    font-weight: 500;
    color: #92400e;
  }

  .product-tagline {
    font-size: var(--text-base);
    color: #78350f;
    font-weight: 500;
    margin: 0;
  }

  /* Feature list */
  .product-features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .product-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .feature-icon {
    flex-shrink: 0;
    font-weight: 700;
    color: #b45309;
    margin-top: 0.1em;
  }

  /* CTA */
  .product-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.9rem var(--space-5);
    background: #d97706;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    border-radius: var(--radius-md);
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-standard);
    box-sizing: border-box;
  }

  .product-cta:hover {
    background: #b45309;
  }

  .product-trust {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    margin: var(--space-3) 0 0 0;
  }

  .product-guarantee {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    margin: 0.375rem 0 0 0;
    font-style: italic;
  }
</style>
