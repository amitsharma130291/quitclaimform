---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://whatisaquitclaimdeed.com';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "WhatIsAQuitclaimDeed.com",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.svg`,
  "description": "Self-help legal document preparation service for quitclaim deeds in all 50 states.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "url": `${siteUrl}/contact/`
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Fonts preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:site_name" content="WhatIsAQuitclaimDeed.com" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Organization JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
</head>
<body>
  <!-- Skip link for accessibility -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />
</body>
</html>
