---
<div class="bg-gray-50 border border-gray-200 rounded-lg p-6 my-8">
  <div class="bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded-t-lg -mx-6 -mt-6 mb-6">
    Free Quitclaim Deed Generator — Instant PDF Download
  </div>
  <form id="deed-form" class="space-y-5">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">State <span class="text-red-500">*</span></label>
      <select name="state" required class="w-full border border-gray-300 rounded px-3 py-2">
        <option value="">Select your state...</option>
        {states.map(s => <option value={s.code}>{s.name}</option>)}
      </select>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Grantor (Transferring Party) <span class="text-red-500">*</span></label>
        <input type="text" name="grantorName" required placeholder="Full legal name" class="w-full border border-gray-300 rounded px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Grantee (Receiving Party) <span class="text-red-500">*</span></label>
        <input type="text" name="granteeName" required placeholder="Full legal name" class="w-full border border-gray-300 rounded px-3 py-2" />
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Property Address <span class="text-red-500">*</span></label>
      <input type="text" name="propertyAddress" required placeholder="123 Main St, City, State ZIP" class="w-full border border-gray-300 rounded px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Legal Description <span class="text-red-500">*</span></label>
      <textarea name="legalDescription" required rows="4" placeholder="Lot 5, Block 12, ABC Subdivision..." class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"></textarea>
      <p class="text-xs text-gray-500 mt-1">Find this on your current deed or property records.</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Consideration</label>
      <input type="text" name="consideration" placeholder="$10.00 (or love and affection)" class="w-full border border-gray-300 rounded px-3 py-2" />
    </div>
    <div class="pt-2">
      <p class="text-xs text-gray-500 mb-3">This document is for informational purposes only. Consult an attorney before using.</p>
      <button type="submit" id="deed-submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors">
        Generate My Quitclaim Deed — Free Download
      </button>
      <p id="deed-status" class="text-sm text-gray-500 mt-2 text-center hidden">Generating your deed...</p>
      <p id="deed-error" class="text-sm text-red-600 mt-2 text-center hidden"></p>
    </div>
  </form>
</div>

<script>
  document.getElementById('deed-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const submitBtn = document.getElementById('deed-submit') as HTMLButtonElement;
    const statusEl = document.getElementById('deed-status') as HTMLElement;
    const errorEl = document.getElementById('deed-error') as HTMLElement;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Generating…';
    statusEl.classList.remove('hidden');
    errorEl.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch('/api/generate-pdf', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => ({ error: 'Request failed' }));
        throw new Error(body.error || `Error ${res.status}`);
      }

      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `quitclaim-deed-${String(data.state).toLowerCase()}.pdf`;
      a.click();
      URL.revokeObjectURL(url);

      statusEl.textContent = 'Your deed is downloading.';
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      statusEl.classList.add('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Generate My Quitclaim Deed — Free Download';
    }
  });
</script>
