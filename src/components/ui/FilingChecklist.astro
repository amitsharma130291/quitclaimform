---
interface ChecklistItem {
  label: string;
  sublabel?: string;
}

interface Props {
  items: ChecklistItem[];
  title?: string;
}

const { items, title } = Astro.props;
---

{title && <h3 class="filing-checklist__title">{title}</h3>}
<ul class="filing-checklist" role="list">
  {items.map(item => (
    <li class="filing-checklist__item">
      <span class="filing-checklist__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="10" fill="#ECFDF3" stroke="#15803D" stroke-width="1.5"/>
          <polyline points="8 12 11 15 16 9" stroke="#15803D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="filing-checklist__text">
        <span class="filing-checklist__label">{item.label}</span>
        {item.sublabel && (
          <span class="filing-checklist__sublabel">{item.sublabel}</span>
        )}
      </span>
    </li>
  ))}
</ul>

<style>
  .filing-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--space-5) 0;
  }

  .filing-checklist__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .filing-checklist__item:hover {
    border-color: var(--color-teal-border);
  }

  .filing-checklist__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    margin-top: 0.1rem;
  }

  .filing-checklist__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .filing-checklist__label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .filing-checklist__sublabel {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
