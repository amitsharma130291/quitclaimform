---
interface Props {
  number: number | string;
  title: string;
  description: string;
  isLast?: boolean;
}

const { number, title, description, isLast = false } = Astro.props;
---

<div class:list={['process-step', { 'process-step--last': isLast }]}>
  <div class="process-step__connector-col">
    <div class="process-step__circle">{number}</div>
    {!isLast && <div class="process-step__line" aria-hidden="true" />}
  </div>
  <div class="process-step__content">
    <h3 class="process-step__title">{title}</h3>
    <p class="process-step__description">{description}</p>
  </div>
</div>

<style>
  .process-step {
    display: flex;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .process-step--last {
    padding-bottom: 0;
  }

  .process-step__connector-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .process-step__circle {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-teal);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px var(--color-teal-light);
  }

  .process-step__line {
    width: 2px;
    flex: 1;
    background: var(--color-teal-border);
    margin-top: var(--space-2);
    min-height: 2rem;
  }

  .process-step__content {
    padding-top: 0.4rem;
    padding-bottom: var(--space-4);
  }

  .process-step__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-h4);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .process-step__description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .process-step {
      gap: var(--space-4);
    }

    .process-step__circle {
      width: 2rem;
      height: 2rem;
      font-size: var(--text-xs);
    }
  }
</style>
