---
interface Props {
  type?: 'info' | 'warning' | 'success' | 'tip';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const icons = {
  info: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`,
  warning: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  success: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
  tip: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="2" x2="12" y2="6"/><path d="M12 6a6 6 0 016 6c0 3.31-2.69 6-6 6s-6-2.69-6-6a6 6 0 016-6z"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`,
};
---

<div class:list={['callout', `callout--${type}`]} role="note">
  <div class="callout__header">
    <span class="callout__icon" set:html={icons[type]} />
    {title && <span class="callout__title">{title}</span>}
  </div>
  <div class="callout__body">
    <slot />
  </div>
</div>

<style>
  .callout {
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-5) 0;
    border-left: 3px solid transparent;
  }

  .callout__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .callout__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .callout__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .callout__body {
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  /* Info */
  .callout--info {
    background: var(--color-info-bg);
    border-color: var(--color-info);
    color: var(--color-info);
  }
  .callout--info .callout__title { color: var(--color-info); }
  .callout--info .callout__body { color: #1e40af; }

  /* Warning */
  .callout--warning {
    background: var(--color-warning-bg);
    border-color: var(--color-warning);
    color: var(--color-warning);
  }
  .callout--warning .callout__title { color: var(--color-warning); }
  .callout--warning .callout__body { color: #92400e; }

  /* Success */
  .callout--success {
    background: var(--color-success-bg);
    border-color: var(--color-success);
    color: var(--color-success);
  }
  .callout--success .callout__title { color: var(--color-success); }
  .callout--success .callout__body { color: #14532d; }

  /* Tip */
  .callout--tip {
    background: var(--color-teal-light);
    border-color: var(--color-teal);
    color: var(--color-teal);
  }
  .callout--tip .callout__title { color: var(--color-teal-hover); }
  .callout--tip .callout__body { color: var(--color-teal-active); }
</style>
